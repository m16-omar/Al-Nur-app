# Example environment for running the server with environment variables
# (Docker, CI, any host other than Serverpod Cloud).
#
# Serverpod reads any password from SERVERPOD_PASSWORD_<name>; this is the
# same set as config/passwords.example.yaml. Copy to `.env`, fill in real
# values, and NEVER commit `.env` (it is gitignored).
#
# On Serverpod Cloud set them with:  scloud password set <name> <value>

SERVERPOD_PASSWORD_database=
SERVERPOD_PASSWORD_serviceSecret=

# Al-Nur Store admin panel (/admin)
SERVERPOD_PASSWORD_alnurAdminEmail=admin@yourstore.com
SERVERPOD_PASSWORD_alnurAdminPassword=
SERVERPOD_PASSWORD_alnurAdminName=Store Administrator

# Nupe Songs Studio (/nupe-admin)
SERVERPOD_PASSWORD_nupeStudioAdminEmail=
SERVERPOD_PASSWORD_nupeStudioAdminPassword=
SERVERPOD_PASSWORD_nupeStudioAdminName=Nupe Studio Admin

# Payments (server only)
SERVERPOD_PASSWORD_monnifyApiKey=
SERVERPOD_PASSWORD_monnifySecretKey=
SERVERPOD_PASSWORD_monnifyContractCode=
SERVERPOD_PASSWORD_monnifyBaseUrl=https://sandbox.monnify.com

# Email
SERVERPOD_PASSWORD_smtpEmail=
SERVERPOD_PASSWORD_smtpAppPassword=
SERVERPOD_PASSWORD_emailRelaySecret=

# AI stylist
SERVERPOD_PASSWORD_geminiApiKey=

# Cloudflare R2 storage
SERVERPOD_PASSWORD_r2AccountId=
SERVERPOD_PASSWORD_r2Bucket=alnur-store
SERVERPOD_PASSWORD_r2PublicHost=
SERVERPOD_PASSWORD_R2AccessKeyId=
SERVERPOD_PASSWORD_R2SecretKey=

# Auth (serverpod_auth_idp)
SERVERPOD_PASSWORD_emailSecretHashPepper=
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=

# Optional
SERVERPOD_PASSWORD_corsAllowedOrigins=
